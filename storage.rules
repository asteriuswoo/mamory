rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 매장별 첨부 파일(발주 메모 사진/영상, 결제 영수증)은 stores/{storeId}/
    // 아래에 둔다 — Firestore 데이터 구조와 맞춰서 매장끼리 경로가 안
    // 섞이게. avatars는 계정(전화번호) 단위라 매장 구분과 무관해 그대로 둔다.
    match /stores/{storeId}/notePhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /stores/{storeId}/noteVideos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
    match /stores/{storeId}/receiptPhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // ---- 아래는 마이그레이션 전 옛 평평한 경로들 — 롤백 안전망으로 1~2주
    // 정도 남겨둔다. 새 코드는 이제 전부 위 stores/{storeId}/ 경로만 쓴다.
    match /notePhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /noteVideos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
    match /receiptPhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // 프로필 사진. 계정 전화번호별 고정 경로라 재업로드하면 이전 사진을 덮어씀.
    match /avatars/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
