rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 이 링크를 아는 사람만 접근할 수 있는 내부용 앱입니다.
    // 익명(anonymous) 로그인된 사용자만 읽고 쓸 수 있도록 최소한의 보호를 겁니다.
    match /materials/{materialId} {
      allow read, write: if request.auth != null;
    }
    match /checks/{dateId} {
      allow read, write: if request.auth != null;
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
      match /requestBatches/{batchId} {
        allow read, write: if request.auth != null;
      }
      match /orderBatches/{batchId} {
        allow read, write: if request.auth != null;
      }
      match /autoPending/{materialId} {
        allow read, write: if request.auth != null;
      }
    }
    match /cashRegister/{dateId} {
      allow read, write: if request.auth != null;
      match /entries/{entryId} {
        allow read, write: if request.auth != null;
      }
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
    }
    match /topups/{topupId} {
      allow read, write: if request.auth != null;
    }
    match /payrollRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    match /schedules/{entryId} {
      allow read, write: if request.auth != null;
    }
    match /humanityCracks/{entryId} {
      allow read, write: if request.auth != null;
    }
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }
    match /songOfTheDay/{dateId} {
      allow read, write: if request.auth != null;
    }
    match /shares/{dateId} {
      allow read, write: if request.auth != null;
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }
    match /accounts/{phone} {
      allow read, write: if request.auth != null;
      match /shifts/{shiftId} {
        allow read, write: if request.auth != null;
      }
      match /attendance/{stampId} {
        allow read, write: if request.auth != null;
      }
      match /notifications/{notifId} {
        allow read, write: if request.auth != null;
      }
    }
    // 사장님용 collectionGroup(db, "attendance") 쿼리(모든 직원의 오늘 도장을
    // 한 번에 훑어보기)는 위의 accounts/{phone}/attendance 경로별 규칙이
    // 아니라 이 재귀 와일드카드 규칙으로 별도 허용해야 동작한다 — Firestore
    // 규칙은 collection group 쿼리를 경로 한정 규칙과 다르게 취급한다.
    match /{path=**}/attendance/{stampId} {
      allow read: if request.auth != null;
    }
    match /config/{doc} {
      allow read, write: if request.auth != null;
    }
    match /meta/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
